{
  "manifest_version": 3,
  "name": "TagSafe",
  "version": "1.0.0",
  "description": "Content warning tags for Bluesky.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "tagsafe@jerryfoxo",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}